  "narrative": {
    "northStar": "Catatan yang jadi rencana",
    "overview": "Halaman publik memakai dunia brief, lembar dokumen, pensil dan folder. Tulisan\ntangan memberi suara santai pada judul; garis tinta dan aksen kertas mengikat\nilustrasi, kartu dan tombol. Arahan ini mengikuti permintaan doodle dan empat\nscreenshot referensi pengguna.\n\nIsi panjang dan formulir memakai huruf yang mudah dibaca. Halaman kebijakan\nmenempatkan ilustrasi di kepala halaman, lalu memberi ruang pada teks dan daftar\nisi. Sistem ini berlaku pada halaman publik, autentikasi dan fallback umum.\nDashboard dan workspace mempertahankan tipografi serta komponen aplikasi.",
    "keyCharacteristics": [
      "Judul tulisan tangan dengan isi Manrope.",
      "Kertas krem, tinta hijau gelap dan sorotan kuning terbatas.",
      "Doodle dokumen, folder, pensil, penjepit dan selotip dari pustaka aset proyek.",
      "Tombol berbingkai tinta, kartu seperti lembar catatan, fokus keyboard jelas."
    ],
    "rules": [
      {
        "name": "The Reading Rule",
        "body": "Tulisan tangan menandai judul dan catatan; isi hukum, harga, label formulir dan pesan kesalahan tetap memakai Manrope.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do gunakan aset dokumen dan palet yang sudah tersedia sebagai satu keluarga.",
      "Do pertahankan tulisan tangan pada judul, dengan isi panjang mudah dibaca.",
      "Do periksa menu, fokus keyboard, pemuatan aset dan layout mobile.",
      "Do ambil harga, kuota dan ketersediaan paket dari data layanan."
    ],
    "donts": [
      "Don't terapkan wrapper atau token publik pada dashboard dan workspace.",
      "Don't tampilkan katalog skill internal pada antarmuka.",
      "Don't tambahkan harga, testimoni, sertifikasi atau janji produk yang belum ada.",
      "Don't letakkan dekorasi di atas paragraf kebijakan atau kontrol formulir."
    ]
  }
