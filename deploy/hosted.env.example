# Set these in the hosting secret environment, never in Git with real values.
NODE_ENV=production
APP_URL=https://buatin.domain-anda.id
BETTER_AUTH_URL=https://buatin.domain-anda.id
DATABASE_URL=
DATABASE_DIRECT_URL=
DATABASE_WORKER_URL=
# Vercel also enforces a maximum of 3 per instance automatically.
DATABASE_POOL_MAX=3
DATABASE_WORKER_POOL_MAX=3
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
SUPPORT_EMAIL=
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_REQUIRE_2FA=true
MOCK_LLM=false
LLM_BASE_URL=https://router.domain-anda.id/v1
LLM_AUTH_MODE=header
NINEROUTER_API_KEY=
LLM_MODEL_PLANNER=
LLM_MODEL_WRITER=
LLM_DAILY_BUDGET_USD=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
WORKER_CONCURRENCY=2
REFERENCE_STORAGE=s3
REFERENCE_S3_ENDPOINT=
REFERENCE_S3_REGION=auto
REFERENCE_S3_BUCKET=
REFERENCE_S3_ACCESS_KEY=
REFERENCE_S3_SECRET_KEY=
REFERENCE_SCANNER_PATH=
REFERENCE_SCANNER_HEALTH_PATH=
# Both platforms use the same file/ZIP limits. Vercel enforces 3 MiB automatically.
MAX_REFERENCE_IMAGE_BYTES=3145728
MAX_REFERENCE_DOCUMENT_BYTES=3145728
MAX_ARCHIVE_BYTES=3145728
BACKUP_DIRECTORY=
BACKUP_KEY_FILE=
NEXT_TELEMETRY_DISABLED=1
RAILPACK_PRUNE_DEPS=false
TZ=Asia/Jakarta

# Separate private off-host backup target; never upload BACKUP_KEY_FILE.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
