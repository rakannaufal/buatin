[Unit]
Description=Buatin encrypted database and attachment backup
After=postgresql.service

[Service]
Type=oneshot
User=buatin
Group=buatin
WorkingDirectory=/opt/buatin/current
EnvironmentFile=/etc/buatin.env
Environment=BACKUP_DIRECTORY=/var/lib/buatin/backups
ExecStart=/usr/bin/node --import tsx scripts/backup.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/buatin/backups
# Key must already exist at BACKUP_KEY_FILE; keep an off-host copy separately.
UMask=0077
