[Unit]
Description=Buatin runtime dependency and queue checks
After=buatin-web.service buatin-worker.service

[Service]
Type=oneshot
User=buatin
Group=buatin
WorkingDirectory=/opt/buatin/current
EnvironmentFile=/etc/buatin.env
ExecStart=/usr/bin/node --import tsx scripts/check-production.ts --runtime
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
