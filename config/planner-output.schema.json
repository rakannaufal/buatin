{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "project_slug": {
      "type": "string",
      "maxLength": 80
    },
    "web_type": {
      "type": "string",
      "enum": [
        "landing",
        "company",
        "portfolio",
        "blog",
        "ecommerce",
        "saas",
        "internal",
        "booking",
        "custom"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 300
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "medium", "complex"]
    },
    "features_detected": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": ["id", "evidence"],
        "additionalProperties": false
      }
    },
    "files": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": ["include", "exclude"]
          },
          "reason": {
            "type": "string",
            "maxLength": 140
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": ["id", "decision", "reason", "confidence"],
        "additionalProperties": false
      }
    },
    "missing_info": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 300
          },
          "impact": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "required": ["question", "impact"],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "risks": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "required": [
    "project_name",
    "project_slug",
    "web_type",
    "summary",
    "complexity",
    "features_detected",
    "files",
    "missing_info",
    "assumptions",
    "risks"
  ],
  "additionalProperties": false
}
