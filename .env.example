APP_URL=http://localhost:3000
DATABASE_URL=postgresql://speckit:CHANGE_ME@localhost:5432/speckit
# Optional direct/session connections to the SAME database. Required behind a transaction pooler.
DATABASE_DIRECT_URL=
DATABASE_WORKER_URL=
# Per web/worker process, not a global connection limit.
DATABASE_POOL_MAX=10
DATABASE_WORKER_POOL_MAX=5
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Google Cloud OAuth Web client. Server-only; never prefix with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
SUPPORT_EMAIL=
EMAIL_PROVIDER=local
EMAIL_FROM=Buatin <noreply@example.com>
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# NQ or SQ: must be an active QRIS channel on this merchant account.
DUITKU_QRIS_METHOD=NQ
DUITKU_EXPIRY_MINUTES=15
WORKER_CONCURRENCY=2
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_AUTH_MODE=header
NINEROUTER_API_KEY=
LLM_MODEL_PLANNER=
LLM_MODEL_WRITER=
LLM_REQUEST_TIMEOUT_SEC=300
LLM_HEALTHCHECK_TIMEOUT_SEC=10
LLM_MIN_INTERVAL_MS=500
LLM_MAX_OUTPUT_TOKENS=6000
LLM_TEMPERATURE_PLANNER=0.1
LLM_TEMPERATURE_WRITER=0.4
LLM_SYSTEM_AS_USER=false
MAX_LLM_RESPONSE_BYTES=1048576
MAX_LLM_INPUT_BYTES=262144
# Includes routing/provider prompt overhead; calibrate from real usage.
LLM_INPUT_TOKEN_OVERHEAD=8192
LLM_DAILY_REQUEST_LIMIT=2000
LLM_USER_DAILY_REQUEST_LIMIT=500
LLM_DAILY_TOKEN_LIMIT=20000000
LLM_USER_DAILY_TOKEN_LIMIT=4000000
# UTC daily estimate cap; public launch requires verified conservative rates.
# Set rates at least as high as every selected model (including vision).
# A provider-side spending cap remains necessary for authoritative billing.
LLM_DAILY_BUDGET_USD=0
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
MAX_LLM_CALLS_PER_JOB=400
MAX_FILE_TOTAL_REQUESTS=8
MAX_BRIEF_CHARS=8000
MAX_BRIEF_UPLOAD_BYTES=131072
MAX_REFERENCE_FILES=10
MAX_REFERENCE_IMAGE_BYTES=5242880
MAX_REFERENCE_DOCUMENT_BYTES=10485760
MAX_REFERENCE_TOTAL_BYTES=26214400
REFERENCE_STORAGE=local
REFERENCE_STORAGE_DIR=.local/references
# Required for PDF/DOCX on public domains; executable ClamAV-compatible scanner.
REFERENCE_SCANNER_PATH=
REFERENCE_PARSE_TIMEOUT_MS=20000
# Private S3-compatible bucket; never expose these credentials to clients.
REFERENCE_S3_ENDPOINT=
REFERENCE_S3_REGION=auto
REFERENCE_S3_BUCKET=
REFERENCE_S3_ACCESS_KEY=
REFERENCE_S3_SECRET_KEY=
# Explicit vision-capable model ID; empty disables image analysis.
LLM_VISION_MODEL=
MAX_DOC_FILES=42
MAX_PLANS_PER_HOUR=10
DRAFT_TTL_HOURS=24
JOB_HEARTBEAT_SEC=30
JOB_STALE_AFTER_SEC=900
MAX_ARCHIVE_BYTES=20971520
TEMPLATES_DIR=./templates
TEMPLATE_SOURCE=builtin
ADMIN_REQUIRE_2FA=true
BACKUP_DIRECTORY=.local/backups
BACKUP_KEY_FILE=.local/backup-key
BACKUP_MAX_AGE_HOURS=36
MOCK_LLM=true
MOCK_LLM_BASE_URL=http://127.0.0.1:4010/v1
MOCK_LLM_API_KEY=mock-fixture-not-a-real-key
TZ=Asia/Jakarta

CLARIFY_MODE=auto

# Separate private off-host backup target; never upload BACKUP_KEY_FILE.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
