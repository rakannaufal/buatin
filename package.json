{
  "name": "buatin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "npm run db:generate && next build",
    "build:worker": "tsc -p tsconfig.worker.json",
    "build:hosted": "node --import tsx scripts/build-hosted.ts",
    "start": "next start --hostname 127.0.0.1",
    "start:worker": "tsx src/worker/index.ts",
    "start:hosted": "node --import tsx scripts/hosted.ts web",
    "start:hosted-worker": "node --import tsx scripts/hosted.ts worker",
    "check:hosted": "node --import tsx scripts/hosted.ts check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --maxWorkers=1",
    "test:e2e": "playwright test",
    "security:scan": "node --import tsx scripts/security-scan.ts",
    "skills:verify": "node --import tsx scripts/skills.ts",
    "skills:sync": "node --import tsx scripts/skills.ts --fetch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "tsx scripts/local-db.ts",
    "owner:create": "tsx scripts/owner.ts create",
    "owner:reset": "tsx scripts/owner.ts reset",
    "mock": "tsx scripts/mock-llm.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:backup": "node --import tsx scripts/backup.ts",
    "db:check-restore": "tsx scripts/check-restore.ts",
    "db:stop": "tsx scripts/local-db.ts --stop",
    "test:recovery": "node --import tsx scripts/check-worker-restart.ts",
    "test:migrations": "node --import tsx scripts/check-admin-upgrade.ts",
    "check:production": "node --import tsx scripts/check-production.ts",
    "provider:check": "node --import tsx scripts/check-provider.ts",
    "backup:key": "node --import tsx scripts/backup-key.ts",
    "backup:verify": "node --import tsx scripts/backup.ts",
    "templates:verify": "node --import tsx scripts/check-templates.ts",
    "ops:check": "node --import tsx scripts/check-production.ts --runtime",
    "test:backup": "node --import tsx scripts/check-backup.ts",
    "security:history": "node --import tsx scripts/security-history.ts",
    "deploy:smoke": "node --import tsx scripts/check-deployment.ts",
    "backup:download": "node --import tsx scripts/download-backup.ts",
    "test:request": "vitest run tests/request --maxWorkers=1",
    "test:assets": "node scripts/check-hosted-assets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "5.104.5",
    "archiver": "8.0.0",
    "better-auth": "1.7.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.8",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/archiver": "8.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
